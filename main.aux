\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Electrode quantities against the bulk temperature \(T_{\rm  bulk}\), for the cathode at \(J_{\rm  app}=10^{8}\ \mathrm  {A\,m^{-2}}\) (left) and the anode at \(|J_{\rm  app}|=10^{7}\ \mathrm  {A\,m^{-2}}\) (right). Filled symbols: the cases of table~\ref {tab:base}. (a), (b) Heat flux into the electrode \(q_w\), equation~(\ref {eq:bc-qwall}). (c), (d) Ion fraction of the current density at the surface, positive for ions flowing into the cathode; at the anode the ions also flow into the surface, against the current. (e), (f) Potential at the sheath edge \(\phi _{\rm  s}\) and at the bulk-plasma boundary \(\phi (L)\), relative to the electrode. (g), (h) Sheath width \(x_{\rm  s}\), the distance from the surface at which \(|n_i-n_e|/n_i\) falls to 1\,\%.}}{19}{figure.8}\protected@file@percent }
\newlabel{fig:sweep-T}{{8}{19}{Electrode quantities against the bulk temperature \(T_{\rm bulk}\), for the cathode at \(J_{\rm app}=10^{8}\ \mathrm {A\,m^{-2}}\) (left) and the anode at \(|J_{\rm app}|=10^{7}\ \mathrm {A\,m^{-2}}\) (right). Filled symbols: the cases of table~\ref {tab:base}. (a), (b) Heat flux into the electrode \(q_w\), equation~(\ref {eq:bc-qwall}). (c), (d) Ion fraction of the current density at the surface, positive for ions flowing into the cathode; at the anode the ions also flow into the surface, against the current. (e), (f) Potential at the sheath edge \(\phi _{\rm s}\) and at the bulk-plasma boundary \(\phi (L)\), relative to the electrode. (g), (h) Sheath width \(x_{\rm s}\), the distance from the surface at which \(|n_i-n_e|/n_i\) falls to 1\,\%}{figure.8}{}}
