\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Base cases: cathode (left) and anode (right). \(x\) is the distance from the electrode; the cathode surface is at the left edge of its panels and the anode surface at the right edge of its panels, marked by the hatched strip. The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. (a), (b) Electron, ion and atom number densities. (c), (d) Electron and heavy-particle temperatures, and the effective ion temperature \(T_{\rm  eff}\) of the two-temperature ion mobility (Appendix~\ref {app:transport}), shown where \(n_n>n_i\), the range in which the ion--atom closure applies. (e), (f) Potential relative to the electrode. (g), (h) Ion fraction of the current density, positive for ions flowing into the electrode.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:base-profiles}{{3}{11}{Base cases: cathode (left) and anode (right). \(x\) is the distance from the electrode; the cathode surface is at the left edge of its panels and the anode surface at the right edge of its panels, marked by the hatched strip. The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. (a), (b) Electron, ion and atom number densities. (c), (d) Electron and heavy-particle temperatures, and the effective ion temperature \(T_{\rm eff}\) of the two-temperature ion mobility (Appendix~\ref {app:transport}), shown where \(n_n>n_i\), the range in which the ion--atom closure applies. (e), (f) Potential relative to the electrode. (g), (h) Ion fraction of the current density, positive for ions flowing into the electrode}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Steady electron energy balance, equation~(\ref {eq:eenergy}), for (a) the cathode and (b) the anode: every term except \(\partial \mathcal  {E}/\partial t\). Dashed: the divergence of the electron energy flux~(\ref {eq:heatflux-e}), \(-\nabla \cdot \mathbf  {h}_e\). Solid: the volume terms, i.e.\ Joule heating, elastic exchange with the heavy particles, the ionization sink and the radiative loss. Positive terms heat the electrons. The hatched strip marks the electrode surface: the cathode at the left of panel (a), the anode at the right of panel (b). The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. The vertical axis is logarithmic in \(|\cdot |\) above \(10^{11}\) (a) and \(10^{6}\ \mathrm  {W\,m^{-3}}\) (b), and linear below.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:base-budget}{{4}{12}{Steady electron energy balance, equation~(\ref {eq:eenergy}), for (a) the cathode and (b) the anode: every term except \(\partial \mathcal {E}/\partial t\). Dashed: the divergence of the electron energy flux~(\ref {eq:heatflux-e}), \(-\nabla \cdot \mathbf {h}_e\). Solid: the volume terms, i.e.\ Joule heating, elastic exchange with the heavy particles, the ionization sink and the radiative loss. Positive terms heat the electrons. The hatched strip marks the electrode surface: the cathode at the left of panel (a), the anode at the right of panel (b). The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. The vertical axis is logarithmic in \(|\cdot |\) above \(10^{11}\) (a) and \(10^{6}\ \mathrm {W\,m^{-3}}\) (b), and linear below}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Electron energy balance}{12}{subsection.4.2}\protected@file@percent }
\newlabel{sec:res-energy}{{4.2}{12}{Electron energy balance}{subsection.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Terms of the steady momentum balances of the ions, equation~(\ref {eq:mom-i}), (a) and (b), and of the electrons, equation~(\ref {eq:mom-e}), (c) and (d), at the cathode (left) and the anode (right), within \(100\ \mu \)m of the electrode. Positive terms push the species towards the electrode. Drag: the friction with both collision partners combined; thermal force: the term in \(C_e\) of equation~(\ref {eq:mom-e}) and its reaction \(C_i\) on the ions. Dotted: the inertia \(-m_sn_s(\mathbf  {u}_s\cdot \nabla )\mathbf  {u}_s\), which the model neglects, evaluated with \(\mathbf  {u}_s=\boldsymbol  {\Gamma }_s/n_s\) from the computed fluxes. The vertical dashed line marks the sheath edge \(x_{\rm  s}\) (table~\ref {tab:base}). The vertical axis is logarithmic in \(|\cdot |\) and linear within six decades of the largest term.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:base-momentum}{{5}{13}{Terms of the steady momentum balances of the ions, equation~(\ref {eq:mom-i}), (a) and (b), and of the electrons, equation~(\ref {eq:mom-e}), (c) and (d), at the cathode (left) and the anode (right), within \(100\ \mu \)m of the electrode. Positive terms push the species towards the electrode. Drag: the friction with both collision partners combined; thermal force: the term in \(C_e\) of equation~(\ref {eq:mom-e}) and its reaction \(C_i\) on the ions. Dotted: the inertia \(-m_sn_s(\mathbf {u}_s\cdot \nabla )\mathbf {u}_s\), which the model neglects, evaluated with \(\mathbf {u}_s=\boldsymbol {\Gamma }_s/n_s\) from the computed fluxes. The vertical dashed line marks the sheath edge \(x_{\rm s}\) (table~\ref {tab:base}). The vertical axis is logarithmic in \(|\cdot |\) and linear within six decades of the largest term}{figure.5}{}}
