\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Anode quantities, with the radial loss for \(R=3.5\)~mm, against the bulk temperature \(T_{\rm  bulk}\) at \(|J_{\rm  app}|=4\times 10^{6}\ \mathrm  {A\,m^{-2}}\) (left) and against the current density \(|J_{\rm  app}|\) at \(T_{\rm  bulk}=15\,000\)~K (right). Filled symbols: the anode case of table~\ref {tab:base}. (a), (b) Heat flux into the anode \(q_w\), equation~(\ref {eq:bc-qwall}). (c), (d) Ion fraction of the current density at the surface; negative, because the ions flow into the anode, against the current. (e), (f) Potential at the sheath edge \(\phi _{\rm  s}\) and at the bulk-plasma boundary \(\phi (L)\), relative to the anode. (g), (h) Sheath width \(x_{\rm  s}\), the distance from the surface at which \(|n_i-n_e|/n_i\) falls to 1\,\%.}}{19}{figure.9}\protected@file@percent }
\newlabel{fig:anode-sweep}{{9}{19}{Anode quantities, with the radial loss for \(R=3.5\)~mm, against the bulk temperature \(T_{\rm bulk}\) at \(|J_{\rm app}|=4\times 10^{6}\ \mathrm {A\,m^{-2}}\) (left) and against the current density \(|J_{\rm app}|\) at \(T_{\rm bulk}=15\,000\)~K (right). Filled symbols: the anode case of table~\ref {tab:base}. (a), (b) Heat flux into the anode \(q_w\), equation~(\ref {eq:bc-qwall}). (c), (d) Ion fraction of the current density at the surface; negative, because the ions flow into the anode, against the current. (e), (f) Potential at the sheath edge \(\phi _{\rm s}\) and at the bulk-plasma boundary \(\phi (L)\), relative to the anode. (g), (h) Sheath width \(x_{\rm s}\), the distance from the surface at which \(|n_i-n_e|/n_i\) falls to 1\,\%}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Response of the electrode quantities to a \(+2\,\%\) step of \(|J_{\rm  app}|\). Blue: ion current density \(j_i\) at the surface; orange: heat flux \(q_w\) into the surface; the surface temperature is held fixed. (a), (b) Relative change of each quantity, in units of the relative step \(\Delta J/J=0.02\), for the conditions of table~\ref {tab:base}: (a) cathode, axial acoustics removed, (b) anode. (c), (d) Anode: settling time \(t_{\rm  s}\) of \(j_i\) and \(q_w\) (within 1\,\% of the step of the final value) and relaxation time \(\tau \) of the final exponential approach, which is the same for both quantities, (c) against \(|J_{\rm  app}|\) at \(T_{\rm  bulk}=15\,000\)~K and (d) against \(T_{\rm  bulk}\) at \(|J_{\rm  app}|=4\times 10^{6}\ \mathrm  {A\,m^{-2}}\). At 13\,000~K the slow part of the response is below the tolerance of \(t_{\rm  s}\), and no \(\tau \) is given. Filled symbols: the anode case of table~\ref {tab:base}.}}{20}{figure.10}\protected@file@percent }
\newlabel{fig:timescales}{{10}{20}{Response of the electrode quantities to a \(+2\,\%\) step of \(|J_{\rm app}|\). Blue: ion current density \(j_i\) at the surface; orange: heat flux \(q_w\) into the surface; the surface temperature is held fixed. (a), (b) Relative change of each quantity, in units of the relative step \(\Delta J/J=0.02\), for the conditions of table~\ref {tab:base}: (a) cathode, axial acoustics removed, (b) anode. (c), (d) Anode: settling time \(t_{\rm s}\) of \(j_i\) and \(q_w\) (within 1\,\% of the step of the final value) and relaxation time \(\tau \) of the final exponential approach, which is the same for both quantities, (c) against \(|J_{\rm app}|\) at \(T_{\rm bulk}=15\,000\)~K and (d) against \(T_{\rm bulk}\) at \(|J_{\rm app}|=4\times 10^{6}\ \mathrm {A\,m^{-2}}\). At 13\,000~K the slow part of the response is below the tolerance of \(t_{\rm s}\), and no \(\tau \) is given. Filled symbols: the anode case of table~\ref {tab:base}}{figure.10}{}}
