\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Conditions (top) and computed electrode quantities (bottom). The sheath edge \(x_{\rm  s}\) is the distance from the electrode at which \(|n_i-n_e|/n_i\) falls to \(1\,\%\), and \(\phi _{\rm  s}\) is the potential there; \(\phi (L)\) is the potential at the bulk-plasma boundary. Both potentials are relative to the electrode. Fluxes are towards the electrode.}}{10}{table.2}\protected@file@percent }
\newlabel{tab:base}{{2}{10}{Conditions (top) and computed electrode quantities (bottom). The sheath edge \(x_{\rm s}\) is the distance from the electrode at which \(|n_i-n_e|/n_i\) falls to \(1\,\%\), and \(\phi _{\rm s}\) is the potential there; \(\phi (L)\) is the potential at the bulk-plasma boundary. Both potentials are relative to the electrode. Fluxes are towards the electrode}{table.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Structure of the near-electrode layers}{10}{subsection.4.1}\protected@file@percent }
\newlabel{sec:res-structure}{{4.1}{10}{Structure of the near-electrode layers}{subsection.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Steady profiles at the cathode (left) and the anode (right). \(x\) is the distance from the electrode; the cathode surface is at the left edge of its panels and the anode surface at the right edge of its panels, marked by the hatched strip. The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. (a), (b) Electron and ion number densities, and the equilibrium density \(n_{\rm  eq}(T_h)\): the charged-particle density at which ionization and recombination, equation~(\ref {eq:S}), balance at \(T_e=T_h\) equal to the local heavy-particle temperature, with quasi-neutrality and Dalton's law at \(p_0\). At \(x=L\) it is the imposed bulk density. (c), (d) Electron and heavy-particle temperatures. (e), (f) Potential relative to the electrode. (g), (h) Ion fraction of the current density, positive for ions flowing into the electrode.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:base-profiles}{{3}{11}{Steady profiles at the cathode (left) and the anode (right). \(x\) is the distance from the electrode; the cathode surface is at the left edge of its panels and the anode surface at the right edge of its panels, marked by the hatched strip. The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. (a), (b) Electron and ion number densities, and the equilibrium density \(n_{\rm eq}(T_h)\): the charged-particle density at which ionization and recombination, equation~(\ref {eq:S}), balance at \(T_e=T_h\) equal to the local heavy-particle temperature, with quasi-neutrality and Dalton's law at \(p_0\). At \(x=L\) it is the imposed bulk density. (c), (d) Electron and heavy-particle temperatures. (e), (f) Potential relative to the electrode. (g), (h) Ion fraction of the current density, positive for ions flowing into the electrode}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Steady electron energy balance, equation~(\ref {eq:eenergy}), for (a) the cathode and (b) the anode: every term except \(\partial \mathcal  {E}/\partial t\). Dashed: the divergence of the electron energy flux~(\ref {eq:heatflux-e}), \(-\nabla \cdot \mathbf  {h}_e\). Solid: the volume terms, i.e.\ Joule heating, elastic exchange with the heavy particles, the ionization sink and the radiative loss. Positive terms heat the electrons. The hatched strip marks the electrode surface: the cathode at the left of panel (a), the anode at the right of panel (b). The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. The vertical axis is logarithmic in \(|\cdot |\) above \(10^{11}\) (a) and \(10^{7}\ \mathrm  {W\,m^{-3}}\) (b), and linear below.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:base-budget}{{4}{12}{Steady electron energy balance, equation~(\ref {eq:eenergy}), for (a) the cathode and (b) the anode: every term except \(\partial \mathcal {E}/\partial t\). Dashed: the divergence of the electron energy flux~(\ref {eq:heatflux-e}), \(-\nabla \cdot \mathbf {h}_e\). Solid: the volume terms, i.e.\ Joule heating, elastic exchange with the heavy particles, the ionization sink and the radiative loss. Positive terms heat the electrons. The hatched strip marks the electrode surface: the cathode at the left of panel (a), the anode at the right of panel (b). The distance axis is scaled as \(\ln x+x/x_c\), with \(x_c=50\ \mu \)m: logarithmic near the electrode and smoothly becoming linear towards the bulk plasma, so that both the sheath and the approach to the bulk are visible. The vertical axis is logarithmic in \(|\cdot |\) above \(10^{11}\) (a) and \(10^{7}\ \mathrm {W\,m^{-3}}\) (b), and linear below}{figure.4}{}}
