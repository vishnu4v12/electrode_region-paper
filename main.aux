\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Terms of the steady momentum balances of the ions, equation~(\ref {eq:mom-i}), (a) and (b), and of the electrons, equation~(\ref {eq:mom-e}), (c) and (d), at the cathode (left) and the anode (right), within \(100\ \mu \)m of the electrode. Positive terms push the species towards the electrode. Drag: the friction with both collision partners combined; thermal force: the term in \(C_e\) of equation~(\ref {eq:mom-e}) and its reaction \(C_i\) on the ions. Dotted: the inertia \(-m_sn_s(\mathbf  {u}_s\cdot \nabla )\mathbf  {u}_s\), which the model neglects, evaluated with \(\mathbf  {u}_s=\boldsymbol  {\Gamma }_s/n_s\) from the computed fluxes. The vertical dashed line marks the sheath edge \(x_{\rm  s}\) (table~\ref {tab:base}). The vertical axis is logarithmic in \(|\cdot |\) and linear within six decades of the largest term.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:base-momentum}{{5}{14}{Terms of the steady momentum balances of the ions, equation~(\ref {eq:mom-i}), (a) and (b), and of the electrons, equation~(\ref {eq:mom-e}), (c) and (d), at the cathode (left) and the anode (right), within \(100\ \mu \)m of the electrode. Positive terms push the species towards the electrode. Drag: the friction with both collision partners combined; thermal force: the term in \(C_e\) of equation~(\ref {eq:mom-e}) and its reaction \(C_i\) on the ions. Dotted: the inertia \(-m_sn_s(\mathbf {u}_s\cdot \nabla )\mathbf {u}_s\), which the model neglects, evaluated with \(\mathbf {u}_s=\boldsymbol {\Gamma }_s/n_s\) from the computed fluxes. The vertical dashed line marks the sheath edge \(x_{\rm s}\) (table~\ref {tab:base}). The vertical axis is logarithmic in \(|\cdot |\) and linear within six decades of the largest term}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The sheaths at the cathode (left) and the anode (right). (a), (b) Electron and ion mean free paths, the length \(\lambda _{T_h}\) over which ions and atoms exchange energy, and the electron Debye length, from the local state; dotted: the distance \(x\) from the electrode. (c), (d) Electron density and the Boltzmann relation \(n_B=n_e(x_{\rm  s})\exp [(e/k_B)\DOTSI \intop \ilimits@ _{\phi _{\rm  s}}^{\phi }d\phi '/T_e]\) started at the sheath edge, with the ion density for reference. (e), (f) Ion velocity towards the electrode, \(u_i=\Gamma _i/n_i\), relative to the Bohm velocity \(u_B=\sqrt  {k_B(T_e+T_h)/M}\). The vertical dashed line marks the sheath edge \(x_{\rm  s}\).}}{15}{figure.6}\protected@file@percent }
\newlabel{fig:base-sheath}{{6}{15}{The sheaths at the cathode (left) and the anode (right). (a), (b) Electron and ion mean free paths, the length \(\lambda _{T_h}\) over which ions and atoms exchange energy, and the electron Debye length, from the local state; dotted: the distance \(x\) from the electrode. (c), (d) Electron density and the Boltzmann relation \(n_B=n_e(x_{\rm s})\exp [(e/k_B)\int _{\phi _{\rm s}}^{\phi }d\phi '/T_e]\) started at the sheath edge, with the ion density for reference. (e), (f) Ion velocity towards the electrode, \(u_i=\Gamma _i/n_i\), relative to the Bohm velocity \(u_B=\sqrt {k_B(T_e+T_h)/M}\). The vertical dashed line marks the sheath edge \(x_{\rm s}\)}{figure.6}{}}
\citation{semenov2016numerical}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Terms of the heat flux delivered to the electrode, equation~(\ref {eq:bc-qwall}), positive into the electrode, for the cathode (left) and the anode (right). Orange: heating; blue: emission cooling; black: the net heat flux \(q_w\). At the cathode, \(q_w\) equals the conduction \(k_w(T_{\rm  wall}-T_0)/L_w\) into the electrode body, equation~(\ref {eq:bc-heat-balance}); the anode surface temperature is prescribed.}}{17}{figure.7}\protected@file@percent }
\newlabel{fig:base-qwall}{{7}{17}{Terms of the heat flux delivered to the electrode, equation~(\ref {eq:bc-qwall}), positive into the electrode, for the cathode (left) and the anode (right). Orange: heating; blue: emission cooling; black: the net heat flux \(q_w\). At the cathode, \(q_w\) equals the conduction \(k_w(T_{\rm wall}-T_0)/L_w\) into the electrode body, equation~(\ref {eq:bc-heat-balance}); the anode surface temperature is prescribed}{figure.7}{}}
