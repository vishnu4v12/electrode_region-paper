\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Near-cathode layer in argon at atmospheric pressure, cathode surface temperature \(T_{\rm  w}=3500\)~K and current density \(j_c=10^7\ \mathrm  {A\,m^{-2}}\): present model (solid lines) and Almeida et al.\ \cite  {Almeida2008} (dashed lines, figures~5(b) and 6). (a) Electron and ion number densities. (b) Electron and heavy-particle temperatures. (c) Ion fraction of the current density, \(j_i/j\) (left axis), and field strength \(-E\) (right axis). The hatched strip at the left marks the cathode surface. The shaded region, \(x>L\), lies outside the computational domain.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:val-cathode}{{1}{9}{Near-cathode layer in argon at atmospheric pressure, cathode surface temperature \(T_{\rm w}=3500\)~K and current density \(j_c=10^7\ \mathrm {A\,m^{-2}}\): present model (solid lines) and Almeida et al.\ \cite {Almeida2008} (dashed lines, figures~5(b) and 6). (a) Electron and ion number densities. (b) Electron and heavy-particle temperatures. (c) Ion fraction of the current density, \(j_i/j\) (left axis), and field strength \(-E\) (right axis). The hatched strip at the left marks the cathode surface. The shaded region, \(x>L\), lies outside the computational domain}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Near-anode layer in argon at atmospheric pressure, anode surface temperature \(T_{\rm  s}=1000\)~K and current density \(j=1.5\times 10^7\ \mathrm  {A\,m^{-2}}\): present model (solid lines) and Semenov et al.\ \cite  {semenov2016numerical} (dashed lines, figures~3(b), 4 and 5). (a) Electron and ion number densities and the Saha density \(n_{\rm  sa}\). (b) Electron and heavy-particle temperatures. (c) Ion fraction of the current density, \(j_i/j\) (left axis), and electric field \(E\) (right axis). The distance axis is reversed, so that the anode surface, marked by the hatched strip, is at the right. The shaded region, \(x>L\), lies outside the computational domain.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:val-anode}{{2}{9}{Near-anode layer in argon at atmospheric pressure, anode surface temperature \(T_{\rm s}=1000\)~K and current density \(j=1.5\times 10^7\ \mathrm {A\,m^{-2}}\): present model (solid lines) and Semenov et al.\ \cite {semenov2016numerical} (dashed lines, figures~3(b), 4 and 5). (a) Electron and ion number densities and the Saha density \(n_{\rm sa}\). (b) Electron and heavy-particle temperatures. (c) Ion fraction of the current density, \(j_i/j\) (left axis), and electric field \(E\) (right axis). The distance axis is reversed, so that the anode surface, marked by the hatched strip, is at the right. The shaded region, \(x>L\), lies outside the computational domain}{figure.2}{}}
